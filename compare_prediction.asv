clc; 
clear; 
addpath('./algorithm'); 
addpath('./signal'); 
% ……………………parameter………………………
K = 100; 
N = 2000; 
MSDg = zeros(1,N); 
MSDb = zeros(1,N); 
MSDr = zeros(1,N); 
MSDk = zeros(1,N); 
MSDm = zeros(1,N); 
MSDy = zeros(1,N); 
lamada = 0.5;
%………………………………………………………………………………………………
for k = 1:K  
% ………………………………………
L = 4; 
unknown_w = unifrnd(-0.5,0.5,L,1) + 1j*unifrnd(-0.5,0.5,L,1);
% ………………………………………     
   Input = AR1_signal(N);
%        Input = ARMA_signal(N);
  D = [Input(2:end) 0];
  noise = Complex_CG(N,0.008,0.002,0.01,8,2);
  Output = D+noise;
unknown_w2= [unknown_w;zeros(L,1)];
Lw = length(unknown_w2); % 
%…………………………………………………
    [Da]= LNCCHS(Input,Output,noise,D,unknown_w2,Lw,0.6,0.5,0.001,-5);
    MSDg = MSDg + Da.MSE;  
    [Da]= NCCHS2(Input,Output,noise,D,unknown_w2,Lw,0.6,0.5,0.005,-5);
    MSDb = MSDb + Da.MSE;
    [Da]= LNCCHS(Input,Output,noise,D,unknown_w2,Lw,0.6,0.5,0.01,-5);
    MSDr = MSDr + Da.MSE;
    [Da]= NCCHS2(Input,Output,noise,D,unknown_w2,Lw,0.6,0.5,0.01,-5);
    MSDk = MSDk + Da.MSE;
end
%………………………………………………………………………………………………
%…………………………………
MSDg = MSDg/K;  
MSDb = MSDb/K;  
MSDr = MSDr/K;  
MSDk = MSDk/K;  
figure(1);
plot(10*log10(smooth(MSDg,10)),'g','linewidth',1);
hold on;
plot(10*log10(smooth(MSDb,10)),'b','linewidth',1);
hold on;
plot(10*log10(smooth(MSDr,10)),'r','linewidth',1);
hold on;
plot(10*log10(smooth(MSDk,10)),'k','linewidth',1);
hold on;
xlabel('iteration','FontSize',15,'FontName','Times New Roman');
ylabel('MSE(dB)','FontSize',15,'FontName','Times New Roman');
h=legend('WL-NCCHSAF \mu=0.03','NCCHSAF \mu=0.03 ','WL-NCCHSAF \mu=0.05','NCCHSAF \mu=0.05');
% h=legend('CHSAF \mu=0.005','WL-CHSAF \mu=0.005 ','CHSAF \mu=0.01','WL-CHSAF \mu=0.01');
set(h,'FontSize',10,'FontName','Times New Roman');